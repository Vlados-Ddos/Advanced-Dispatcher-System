<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net48</TargetFramework><AssemblyName>AdvancedDispatcherSystem.Passenger</AssemblyName></PropertyGroup>
  <PropertyGroup>
    <PassengerJobsReferencePath Condition="'$(PassengerJobsReferencePath)' == '' and Exists('$(GameRoot)/Mods/PassengerJobs/PassengerJobs.dll')">$(GameRoot)/Mods/PassengerJobs/PassengerJobs.dll</PassengerJobsReferencePath>
    <PassengerJobsReferencePath Condition="'$(PassengerJobsReferencePath)' == ''">$(MSBuildThisFileDirectory)../../tools/references/PassengerJobs.dll</PassengerJobsReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AdvancedDispatcherSystem.Game/AdvancedDispatcherSystem.Game.csproj" />
    <Reference Include="PassengerJobs"><HintPath>$(PassengerJobsReferencePath)</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)/DerailValley_Data/Managed/*.dll" Exclude="$(GameRoot)/DerailValley_Data/Managed/mscorlib.dll;$(GameRoot)/DerailValley_Data/Managed/System*.dll;$(GameRoot)/DerailValley_Data/Managed/Mono.*.dll;$(GameRoot)/DerailValley_Data/Managed/Microsoft.*.dll;$(GameRoot)/DerailValley_Data/Managed/netstandard.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
